              "content": {
                "format": "text",
                "value": "A. Operational dashboard"
              }
            },
            {
              "id": "B",
              "content": {
                "format": "text",
                "value": "B. Tactical dashboard"
              }
            },
            {
              "id": "C",
              "content": {
                "format": "text",
                "value": "C. Strategic dashboard"
              }
            },
            {
              "id": "D",
              "content": {
                "format": "text",
                "value": "D. Workflow dashboard"
              }
            }
          ],
          "answers": [
